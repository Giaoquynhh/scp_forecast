{
  "name": "scp-forecast",
  "version": "1.0.0",
  "private": true,
  "description": "Tính TT và FC cho branch_forecast — app độc lập, ghi thẳng vào DB, SCP chỉ đọc",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "migrate": "tsx src/index.ts --migrate",
    "cron": "tsx src/index.ts --daemon",
    "acc": "tsx src/index.ts --accuracy",
    "serve": "tsx src/index.ts --serve",
    "fc": "tsx src/index.ts --only fc",
    "tt": "tsx src/index.ts --only tt",
    "dry": "tsx src/index.ts --dry-run",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
